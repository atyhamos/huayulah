rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Private progress: only the owner can read or write.
    match /users/{uid} {
      allow read, write: if isMe(uid);
      match /cards/{cardId} {
        allow read, write: if isMe(uid);
      }
    }

    // What friends can see on the leaderboard.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.weeklyXp is number
        && request.resource.data.xp is number;

      // People who added {uid} as a friend, so the friendship shows on both sides.
      match /followers/{fid} {
        allow read: if isMe(uid);
        allow create, update: if isMe(fid);
        allow delete: if isMe(fid) || isMe(uid);
      }
    }

    // Invite codes → uid. Readable one at a time, never listable.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && code.size() == 6;
      allow update, delete: if false;
    }
  }
}
