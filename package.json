{
  "name": "huayu-lah",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "e2e": "playwright test",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-huayu \"vitest run --config vitest.rules.config.ts\"",
    "gen:pinyin": "tsx scripts/gen-pinyin.ts",
    "gen": "npm run gen:pinyin && tsx scripts/copy-strokes.ts",
    "e2e:cloud": "npx -y firebase-tools@latest emulators:exec --only auth,firestore --project demo-huayu \"playwright test -c playwright.cloud.config.ts\""
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.0.0",
    "hanzi-writer": "^3.7.3",
    "idb-keyval": "^6.3.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "hanzi-writer-data": "^2.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
