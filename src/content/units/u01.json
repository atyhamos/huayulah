    { "id": "ni", "hanzi": "你", "pinyin": "nǐ", "english": "you", "example": { "zh": "你 吃饭 了 吗？", "en": "Have you eaten?" }, "note": "\"吃饭了吗？\" is a very common Singaporean greeting — it just means \"how are you?\"" },
    { "id": "ta-he", "hanzi": "他", "pinyin": "tā", "english": "he / him", "example": { "zh": "他 是 我 的 朋友。", "en": "He is my friend." } },
    { "id": "ta-she", "hanzi": "她", "pinyin": "tā", "english": "she / her", "example": { "zh": "她 是 我 的 妈妈。", "en": "She is my mum." }, "note": "Sounds exactly like 他 — only the written form (女 = woman) is different." },
    { "id": "women", "hanzi": "我们", "pinyin": "wǒ men", "english": "we / us", "type": "word", "example": { "zh": "我们 去 喝 咖啡 吧。", "en": "Let's go and drink coffee." } },
    { "id": "nimen", "hanzi": "你们", "pinyin": "nǐ men", "english": "you (plural)", "example": { "zh": "你们 要 去 哪里？", "en": "Where are you all going?" } },

